# ------------------------------------------------------------------------------
# 1. .NET & Visual Studio / JetBrains Rider
# ------------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
TestResults/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.DotSettings.user
*.pidb
*.booproj

# Visual Studio Cache & Workspaces
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains Rider & ReSharper
.idea/
_ReSharper*/
*.ReSharper

# Roslyn & Source Generators
*.Generated.cs

# User-specific & local published artifacts
*.publishproj
publish/
[Pp]ackages/
!**/packages/build/
*.nupkg
*.snupkg

# ------------------------------------------------------------------------------
# 2. Node.js & Next.js Frontend
# ------------------------------------------------------------------------------
node_modules/
.next/
out/
dist/
build/
.pnpm-store/

# Package Manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js telemetry & cache
.turbo/

# Environment files (.env) - keep .env.example
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# 3. Media Uploads & Runtime Storage
# ------------------------------------------------------------------------------
src/Backend/Presentation/Clinic.WebAPI/wwwroot/uploads/*
!src/Backend/Presentation/Clinic.WebAPI/wwwroot/uploads/.gitkeep

# ------------------------------------------------------------------------------
# 4. OS & System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

